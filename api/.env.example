# Copy to .env — every value is optional for local development.
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# Must match the orchestrator. Required in production: openssl rand -base64 48
JWT_SECRET=
TOKEN_TTL=7d

# Empty = embedded PGlite database in <repo>/.nimbus/db (no Postgres needed).
# With docker compose:  postgres://nimbus:nimbus@localhost:5432/nimbus
DATABASE_URL=
DATABASE_SSL=false

# local = files in <repo>/.nimbus/storage, azure = Azure Blob Storage
STORAGE_DRIVER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=nimbus
PROJECT_NAME=workspace

# Without SMTP settings, verification / reset links are printed to this console.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Copy to .env — every value is optional for local development.
PORT=3002
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Must match the API.
JWT_SECRET=

# local = each user's runtime is a child process on this machine (dev only, no isolation)
# kubernetes = one Deployment + Service per user (uses the current kubeconfig / service account)
ORCHESTRATOR_MODE=local

# Where runtimes download the user's files from.
RUNTIME_API_URL=http://localhost:3001

# kubernetes mode
K8S_NAMESPACE=default
RUNTIME_IMAGE=nimbus/runtime:latest
PREVIEW_PORTS=8080,5173,8000,5000,4200,3001
RUNTIME_CPU_LIMIT=1
RUNTIME_MEMORY_LIMIT=1Gi
SECURE_COOKIES=false

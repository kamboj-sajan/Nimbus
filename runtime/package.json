{
  "name": "@nimbus/runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Nimbus per-user runtime: terminal (PTY), live workspace file system, file watcher",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
